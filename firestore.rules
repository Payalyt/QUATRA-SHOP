rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'GUEST';
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'ADMIN' || 
        getUserRole() == 'SUPER_ADMIN' ||
        ('email' in request.auth.token && (
          request.auth.token.email == 'payalyt6279@gmail.com' ||
          request.auth.token.email == 'admin@bazaarbd.com' ||
          request.auth.token.email == 'admin@quatro.com.bd'
        ))
      );
    }

    function isSeller() {
      return isAuthenticated() && getUserRole() == 'SELLER';
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin() || isAuthenticated();
    }

    // 2. Sellers Directory
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOwner(sellerId) || isAdmin());
      allow delete: if isAdmin();
    }

    // 3. Products Catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 4. Categories, Banners, Coupons & Settings
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin() || isSeller() || isAuthenticated();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // 5. Orders & Transactions
    match /orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // 6. Affiliate Partner Program
    match /affiliates/{affiliateId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /affiliate_links/{linkId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }

    match /affiliate_commissions/{commissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || isAuthenticated();
    }

    match /affiliate_withdrawals/{withdrawalId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isAuthenticated();
    }

    // 7. Seller Deposits
    match /seller_deposits/{depositId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || isAuthenticated();
    }

    // 8. Leads & Customer Inquiries
    match /leads/{leadId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || isAuthenticated();
    }

    // 9. Sub-Agents Directory
    match /subagents/{subAgentId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }
  }
}
