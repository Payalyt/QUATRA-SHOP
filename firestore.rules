rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'payalyt6279@gmail.com' ||
        request.auth.token.email == 'admin@bazaarbd.com' ||
        request.auth.token.email == 'admin@quatro.com.bd' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN')
      );
    }

    // 1. Users
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 2. Sellers Directory
    match /sellers/{sellerId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 3. Products Catalog
    match /products/{productId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 4. Categories, Banners, Coupons & Settings
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 5. Orders & Transactions
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 6. Affiliate Partner Program
    match /affiliates/{affiliateId} {
      allow read: if true;
      allow write: if true;
    }

    match /affiliate_links/{linkId} {
      allow read: if true;
      allow write: if true;
    }

    match /affiliate_commissions/{commissionId} {
      allow read: if true;
      allow write: if true;
    }

    match /affiliate_withdrawals/{withdrawalId} {
      allow read: if true;
      allow write: if true;
    }

    // 7. Seller Deposits
    match /seller_deposits/{depositId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. Leads & Customer Inquiries
    match /leads/{leadId} {
      allow read: if true;
      allow write: if true;
    }

    // 9. Sub-Agents Directory
    match /subagents/{subAgentId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
