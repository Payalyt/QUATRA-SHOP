# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for callbacks and webhooks
APP_URL="MY_APP_URL"

# -------------------------------------------------------------
# 1. SMS GATEWAY API (Greenweb / BulkSMS / BD SMS API)
# -------------------------------------------------------------
SMS_API_KEY="YOUR_SMS_GATEWAY_API_KEY"
SMS_SENDER_ID="QUATRO_BD"
SMS_API_URL="https://api.sms-gateway-bd.com/api/v3/sms/send"

# -------------------------------------------------------------
# 2. BKASH MERCHANT DIRECT API (Tokenized Checkout & Verify)
# -------------------------------------------------------------
BKASH_APP_KEY="YOUR_BKASH_APP_KEY"
BKASH_APP_SECRET="YOUR_BKASH_APP_SECRET"
BKASH_USERNAME="YOUR_BKASH_MERCHANT_USERNAME"
BKASH_PASSWORD="YOUR_BKASH_MERCHANT_PASSWORD"
BKASH_BASE_URL="https://tokenized.pay.bka.sh/v1.2.0-beta"

# -------------------------------------------------------------
# 3. NAGAD MERCHANT API
# -------------------------------------------------------------
NAGAD_MERCHANT_ID="YOUR_NAGAD_MERCHANT_ID"
NAGAD_PUBLIC_KEY="YOUR_NAGAD_PUBLIC_KEY"
NAGAD_PRIVATE_KEY="YOUR_NAGAD_PRIVATE_KEY"
NAGAD_BASE_URL="https://api.mynagad.com/api/dfs"

# -------------------------------------------------------------
# 4. SSLCOMMERZ PAYMENT GATEWAY API (15-20 days later)
# -------------------------------------------------------------
SSLCOMMERZ_STORE_ID="YOUR_SSLCOMMERZ_STORE_ID"
SSLCOMMERZ_STORE_PASS="YOUR_SSLCOMMERZ_STORE_PASSWORD"
SSLCOMMERZ_IS_SANDBOX="false"

# -------------------------------------------------------------
# 5. STEADFAST COURIER API (Automated Booking & Tracking)
# -------------------------------------------------------------
STEADFAST_API_KEY="YOUR_STEADFAST_API_KEY"
STEADFAST_SECRET_KEY="YOUR_STEADFAST_SECRET_KEY"
STEADFAST_BASE_URL="https://portal.steadfast.com.bd/api/v1"

# -------------------------------------------------------------
# 6. PATHAO COURIER API
# -------------------------------------------------------------
PATHAO_CLIENT_ID="YOUR_PATHAO_CLIENT_ID"
PATHAO_CLIENT_SECRET="YOUR_PATHAO_CLIENT_SECRET"
PATHAO_USERNAME="YOUR_PATHAO_EMAIL"
PATHAO_PASSWORD="YOUR_PATHAO_PASSWORD"
PATHAO_STORE_ID="YOUR_PATHAO_STORE_ID"

# -------------------------------------------------------------
# 7. REDX, PAPERFLY & ECOURIER APIS
# -------------------------------------------------------------
REDX_API_KEY="YOUR_REDX_API_KEY"
PAPERFLY_KEY="YOUR_PAPERFLY_KEY"
ECOURIER_API_KEY="YOUR_ECOURIER_API_KEY"

# -------------------------------------------------------------
# 8. IMAGE HOSTING API (ImgBB / PostImages) - Free Tier Ready
# -------------------------------------------------------------
IMGBB_API_KEY="af809d0258b5e1ff2cfd804ff207b609"

# -------------------------------------------------------------
# 8. FUTURE CLOUD STORAGE API (Cloudinary / AWS S3 / R2 / GCS)
