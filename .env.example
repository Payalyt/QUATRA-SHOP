# -------------------------------------------------------------
# Option A: Cloudinary (Images & HD Video Hosting)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""

# Option B: Cloud S3 / Cloudflare R2 / AWS S3
AWS_S3_BUCKET=""
