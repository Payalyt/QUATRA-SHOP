// Prisma Schema for QUATRO E-Commerce Marketplace
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  ACTIVE
  PENDING_REVIEW
  INACTIVE
  REJECTED
}

enum Role {
  CUSTOMER
  ADMIN
  SELLER
  AFFILIATE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  RETURNED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
  SSLCOMMERZ
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  avatar       String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlists    Wishlist[]
  cart         Cart?
  seller       Seller?
  shopFollows  ShopFollower[]
  productQnas  ProductQnA[]

  @@map("users")
}

model Address {
  id           String   @id @default(cuid())
  userId       String
  fullName     String
  phone        String
  division     String   // e.g. Dhaka, Chittagong, Sylhet
  district     String   // e.g. Dhaka, Gazipur, Narayanganj
  thana        String?  // e.g. Dhanmondi, Gulshan, Mirpur
  addressLine  String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@map("addresses")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  nameBn      String     // Bengali translation
  slug        String     @unique
  icon        String?
  image       String?
  parentId    String?
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

model Product {
  id              String         @id @default(cuid())
  title           String
  titleBn         String         // Bengali title
  slug            String         @unique
  description     String
  descriptionBn   String?
  price           Float          // Current Selling Price in BDT
  originalPrice   Float          // Struck-through Price
  discountPercent Int            @default(0)
  stock           Int            @default(0)
  brand           String
  sku             String?        @unique
  rating          Float          @default(0.0)
  reviewCount     Int            @default(0)
  soldCount       Int            @default(0)
  isFeatured      Boolean        @default(false)
  isFlashSale     Boolean        @default(false)
  flashSaleEnd    DateTime?
  warranty        String?        // e.g. "1 Year Official Warranty"
  videoUrl        String?        // Cloudinary or demo video URL
  specifications  Json?          // Key-value specifications
  categoryId      String
  sellerId        String?
  status          ProductStatus  @default(ACTIVE)
  viewsCount      Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  category        Category       @relation(fields: [categoryId], references: [id])
  seller          Seller?        @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  media           ProductMedia[]
  variants        Variant[]
  reviews         Review[]
  orderItems      OrderItem[]
  cartItems       CartItem[]
  wishlists       Wishlist[]
  qnas            ProductQnA[]

  @@index([categoryId])
  @@index([sellerId])
  @@index([isFlashSale])
  @@index([brand])
  @@map("products")
}

model ProductMedia {
  id          String   @id @default(cuid())
  productId   String
  url         String   // Cloudinary secure URL
  type        String   @default("IMAGE") // IMAGE or VIDEO
  isThumbnail Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_media")
}

model Variant {
  id          String      @id @default(cuid())
  productId   String
  name        String      // e.g. "Color", "Size", "Storage"
  value       String      // e.g. "Space Grey", "XL", "128GB"
  priceDiff   Float       @default(0.0) // Additional or deducted price
  stock       Int         @default(10)
  sku         String?

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@map("variants")
}

model Offer {
  id              String    @id @default(cuid())
  title           String
  titleBn         String
  description     String?
  discountPercent Int
  bannerUrl       String
  startTime       DateTime
  endTime         DateTime
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())

  @@map("offers")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   Variant? @relation(fields: [variantId], references: [id])

  @@map("cart_items")
}

model Order {
  id                 String        @id @default(cuid())
  orderNumber        String        @unique // e.g. BZ-2026-89412
  userId             String
  addressId          String?
  shippingAddress    Json          // Full address snapshot
  paymentMethod      PaymentMethod @default(COD)
  paymentStatus      PaymentStatus @default(PENDING)
  orderStatus        OrderStatus   @default(PENDING)
  subtotal           Float
  shippingFee        Float         @default(60.0)
  discount           Float         @default(0.0)
  total              Float
  trackingNumber     String?
  deliveredAt        DateTime?
  returnWindowEndsAt DateTime?     // deliveredAt + 7 days
  returnRequested    Boolean       @default(false)
  returnReason       String?
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  affiliateId        String?

  user               User          @relation(fields: [userId], references: [id])
  address            Address?      @relation(fields: [addressId], references: [id])
  affiliate          Affiliate?    @relation(fields: [affiliateId], references: [id])
  items              OrderItem[]

  @@index([userId])
  @@index([orderStatus])
  @@map("orders")
}

model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  productId   String
  sellerId    String?
  variantId   String?
  title       String
  price       Float
  quantity    Int
  subtotal    Float
  status      OrderStatus @default(PENDING)

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  variant     Variant? @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Review {
  id                  String   @id @default(cuid())
  productId           String
  userId              String
  userName            String
  rating              Int      // 1 to 5
  comment             String
  images              String[] // Cloudinary photos from verified customer
  isVerifiedPurchase  Boolean  @default(true)
  isApproved          Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String
  position  String   @default("HERO") // HERO, MIDDLE_PROMO, DEALS_ROW
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("banners")
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PayoutMethod {
  BKASH
  NAGAD
  BANK
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Seller {
  id                 String              @id @default(cuid())
  userId             String              @unique
  shopName           String
  slug               String              @unique
  logo               String?
  banner             String?
  description        String?
  phone              String
  email              String
  shopAddress        String
  nidTradeLicense    String?             // Uploaded document URL
  status             SellerStatus        @default(PENDING)
  payoutMethod       PayoutMethod        @default(BKASH)
  payoutAccount      String              // e.g. "01712345678" or Bank Account Details
  commissionOverride Float?              // e.g. 5.0 for 5% custom commission rate
  rating             Float               @default(5.0)
  followerCount      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  products           Product[]
  wallet             SellerWallet?
  transactions       SellerTransaction[]
  withdrawals        WithdrawalRequest[]
  notifications      SellerNotification[]
  followers          ShopFollower[]
  qnas               ProductQnA[]
  promotions         SellerPromotion[]

  @@map("sellers")
}

model SellerWallet {
  id               String   @id @default(cuid())
  sellerId         String   @unique
  totalIncome      Float    @default(0.0)
  totalCommission  Float    @default(0.0)
  netEarnings      Float    @default(0.0)
  availableBalance Float    @default(0.0)
  pendingBalance   Float    @default(0.0)
  withdrawnAmount  Float    @default(0.0)
  updatedAt        DateTime @updatedAt

  seller           Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_wallets")
}

model SellerTransaction {
  id          String   @id @default(cuid())
  sellerId    String
  orderId     String?
  amount      Float
  commission  Float    @default(0.0)
  netAmount   Float
  type        String   @default("CREDIT") // CREDIT or DEBIT
  description String
  status      String   @default("PENDING") // PENDING, AVAILABLE, WITHDRAWN
  availableAt DateTime?
  createdAt   DateTime @default(now())

  seller      Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("seller_transactions")
}

model WithdrawalRequest {
  id             String           @id @default(cuid())
  sellerId       String
  amount         Float
  payoutMethod   PayoutMethod
  accountDetails String
  status         WithdrawalStatus @default(PENDING)
  rejectReason   String?
  processedAt    DateTime?
  createdAt      DateTime         @default(now())

  seller         Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("withdrawal_requests")
}

model SellerNotification {
  id        String   @id @default(cuid())
  sellerId  String
  title     String
  message   String
  type      String   @default("ORDER") // ORDER, STOCK, PRODUCT_STATUS, WITHDRAWAL, REVIEW
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("seller_notifications")
}

model ShopFollower {
  id        String   @id @default(cuid())
  sellerId  String
  userId    String
  createdAt DateTime @default(now())

  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sellerId, userId])
  @@map("shop_followers")
}

model ProductQnA {
  id         String    @id @default(cuid())
  productId  String
  sellerId   String
  userId     String
  userName   String
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  seller     Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sellerId])
  @@map("product_qna")
}

model SellerPromotion {
  id              String   @id @default(cuid())
  sellerId        String
  title           String
  discountPercent Int
  productIds      Json     // Array of product IDs included in promo
  startTime       DateTime
  endTime         DateTime
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  seller          Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@map("seller_promotions")
}

enum AffiliateStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

model Affiliate {
  id                String            @id @default(cuid())
  userId            String            @unique
  code              String            @unique
  status            AffiliateStatus   @default(ACTIVE)
  payoutMethod      PayoutMethod
  payoutAccount     String
  availableBalance  Float             @default(0.0)
  pendingBalance    Float             @default(0.0)
  totalEarned       Float             @default(0.0)
  totalWithdrawn    Float             @default(0.0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  links             AffiliateLink[]
  commissions       AffiliateCommission[]
  withdrawals       AffiliateWithdrawal[]

  @@map("affiliates")
}

model AffiliateLink {
  id          String   @id @default(cuid())
  affiliateId String
  productId   String
  slug        String
  createdAt   DateTime @default(now())

  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("affiliate_links")
}

model AffiliateClick {
  id          String   @id @default(cuid())
  affiliateId String
  productId   String
  timestamp   DateTime @default(now())
  ipHash      String
  device      String?
  createdAt   DateTime @default(now())

  @@map("affiliate_clicks")
}

model AffiliateCommission {
  id          String   @id @default(cuid())
  affiliateId String
  orderId     String
  productId   String
  amount      Float
  rate        Float
  status      String   @default("PENDING")
  approveAfter DateTime
  approvedAt  DateTime?
  createdAt   DateTime @default(now())

  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order       Order     @relation(fields: [orderId], references: [id])
  product     Product   @relation(fields: [productId], references: [id])

  @@map("affiliate_commissions")
}

model AffiliateWithdrawal {
  id          String   @id @default(cuid())
  affiliateId String
  amount      Float
  status      String   @default("PENDING")
  rejectReason String?
  requestedAt DateTime @default(now())
  processedAt DateTime?
  txnId       String?

  affiliate   Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@map("affiliate_withdrawals")
}
